{
  "name": "short-circuit",
  "version": "0.1.0",
  "private": true,
  "description": "Short Circuit — a text-first digital logic language and simulation studio.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @shortcircuit/web",
    "build": "npm run build -w @shortcircuit/web && npm run build -w @shortcircuitcli/cli",
    "preview": "npm run preview -w @shortcircuit/web",
    "test": "vitest run",
    "test:packages": "vitest run packages/engine/test/packages.test.ts",
    "test:cli-packed": "node scripts/test-packed-cli.mjs",
    "test:package-cli": "npm --prefix vendor/ShortCircuit-Packages run test:cli",
    "package:init": "npm --prefix vendor/ShortCircuit-Packages run package:init --",
    "package:build": "npm --prefix vendor/ShortCircuit-Packages run package:build",
    "package:test": "npm --prefix vendor/ShortCircuit-Packages run package:test",
    "package:check": "npm --prefix vendor/ShortCircuit-Packages run package:check",
    "package:list": "npm --prefix vendor/ShortCircuit-Packages run package:list",
    "typecheck": "npm run typecheck -w @shortcircuit/engine && npm run typecheck -w @shortcircuit/web && npm run typecheck -w @shortcircuitcli/cli && tsc --noEmit -p tests/tsconfig.json",
    "docs:generate": "node --experimental-strip-types scripts/generate-docs.mts",
    "cli:build": "npm run build -w @shortcircuitcli/cli",
    "cli": "node packages/cli/dist/cli.js"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  }
}
