{
  "name": "@shortcircuitcli/cli",
  "version": "0.3.5",
  "description": "Command line tools for the Short Circuit LogicFlow language.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samTime101/ShortCircuit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/samTime101/ShortCircuit#command-line",
  "bugs": {
    "url": "https://github.com/samTime101/ShortCircuit/issues"
  },
  "keywords": [
    "logicflow",
    "shortcircuit",
    "compiler",
    "simulator",
    "digital-logic"
  ],
  "type": "module",
  "bin": {
    "shortcircuit": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/cli.js --banner:js='#!/usr/bin/env node' && chmod +x dist/cli.js",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@shortcircuit/engine": "*",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "esbuild": "^0.25.0",
    "semver": "^7.8.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
