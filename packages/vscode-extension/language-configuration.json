{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "indentationRules": {
    "increaseIndentPattern": "(?i)^\\s*(circuit|macro|test|case|if|for|on)\\b.*$",
    "decreaseIndentPattern": "(?i)^\\s*(end|else)\\b.*$"
  },
  "folding": {
    "markers": {
      "start": "(?i)^\\s*(circuit|macro|test)\\b",
      "end": "(?i)^\\s*end\\b"
    }
  }
}
