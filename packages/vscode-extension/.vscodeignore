# VS Code extension packaging ignore file
# Ignore everything outside the extension directory
**/../**
**/../../**

# Ignore node_modules - extension is bundled by esbuild
node_modules/

# Ignore source files and tests
src/
test/
*.test.ts
vitest.config.ts
tsconfig.json
build.js
.vscode/

# Ignore build artifacts
*.map
*.tsbuildinfo
*.vsix

# Ignore git
.git/
../.git/
../../.git/

# Ignore system files
.DS_Store
Thumbs.db
*.log
