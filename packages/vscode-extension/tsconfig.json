{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "outDir": "out",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@shortcircuit/engine": ["../engine/src/index.ts"],
      "@shortcircuit/engine/*": ["../engine/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "out", "test"]
}
