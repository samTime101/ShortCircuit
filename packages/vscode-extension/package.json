{
  "name": "shortcircuit",
  "displayName": "Short Circuit",
  "description": "LogicFlow language support for Short Circuit: interactive simulator studio, syntax highlighting, diagnostics, completions, hovers, waveform/truth-table previews, and test runner.",
  "version": "0.1.0",
  "publisher": "samTime101",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Testing",
    "Other"
  ],
  "keywords": [
    "logicflow",
    "shortcircuit",
    "digital-logic",
    "hardware-description",
    "simulator"
  ],
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samTime101/ShortCircuit.git"
  },
  "bugs": {
    "url": "https://github.com/samTime101/ShortCircuit/issues"
  },
  "main": "out/extension.js",
  "activationEvents": [
    "onLanguage:logicflow",
    "onView:shortcircuit.studioView",
    "onCommand:shortcircuit.openStudio",
    "onCommand:shortcircuit.expandStudio",
    "onCommand:shortcircuit.openWaveform",
    "onCommand:shortcircuit.openTruthTable",
    "onCommand:shortcircuit.runTest",
    "onCommand:shortcircuit.runAllTests",
    "onCommand:shortcircuit.formatDocument"
  ],
  "contributes": {
    "languages": [
      {
        "id": "logicflow",
        "aliases": [
          "LogicFlow",
          "Short Circuit",
          "logicflow"
        ],
        "extensions": [
          ".lf"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/shortcircuit.svg",
          "dark": "./media/shortcircuit.svg"
        }
      }
    ],
    "iconThemes": [
      {
        "id": "shortcircuit-icons",
        "label": "Short Circuit",
        "path": "./icons/icon-theme.json"
      }
    ],
    "grammars": [
      {
        "language": "logicflow",
        "scopeName": "source.logicflow",
        "path": "./syntaxes/logicflow.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shortcircuit-sidebar",
          "title": "Short Circuit",
          "icon": "media/shortcircuit.svg"
        }
      ]
    },
    "views": {
      "shortcircuit-sidebar": [
        {
          "type": "webview",
          "id": "shortcircuit.studioView",
          "name": "Short Circuit Studio"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Short Circuit",
      "properties": {
        "shortcircuit.registryUrl": {
          "type": "string",
          "default": "https://raw.githubusercontent.com/samTime101/ShortCircuit-Packages/main/registry.json",
          "description": "Registry URL for package installation"
        },
        "shortcircuit.enablePreview": {
          "type": "boolean",
          "default": true,
          "description": "Enable waveform and truth-table previews"
        },
        "shortcircuit.test.autoRun": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run tests on save"
        }
      }
    },
    "commands": [
      {
        "command": "shortcircuit.openStudio",
        "title": "Open Interactive Studio",
        "category": "Short Circuit",
        "icon": "$(circuit-board)"
      },
      {
        "command": "shortcircuit.expandStudio",
        "title": "Expand Studio to Editor",
        "category": "Short Circuit",
        "icon": "$(screen-full)"
      },
      {
        "command": "shortcircuit.openWaveform",
        "title": "Open Waveform Preview",
        "category": "Short Circuit",
        "icon": "$(pulse)"
      },
      {
        "command": "shortcircuit.openTruthTable",
        "title": "Open Truth Table Preview",
        "category": "Short Circuit",
        "icon": "$(table)"
      },
      {
        "command": "shortcircuit.runTest",
        "title": "Run Test",
        "category": "Short Circuit"
      },
      {
        "command": "shortcircuit.runAllTests",
        "title": "Run All Tests in File",
        "category": "Short Circuit"
      },
      {
        "command": "shortcircuit.formatDocument",
        "title": "Format Document",
        "category": "Short Circuit"
      }
    ],
    "menus": {
      "view/title": [
        {
          "when": "view == shortcircuit.studioView",
          "command": "shortcircuit.expandStudio",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "when": "editorLangId == logicflow",
          "command": "shortcircuit.openStudio",
          "group": "navigation"
        },
        {
          "when": "editorLangId == logicflow",
          "command": "shortcircuit.openTruthTable",
          "group": "navigation"
        },
        {
          "when": "editorLangId == logicflow",
          "command": "shortcircuit.openWaveform",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "when": "editorLangId == logicflow",
          "command": "shortcircuit.runTest",
          "group": "shortcircuit"
        },
        {
          "when": "editorLangId == logicflow",
          "command": "shortcircuit.formatDocument",
          "group": "1_modification"
        }
      ]
    },
    "keybindings": [
      {
        "command": "shortcircuit.openStudio",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "editorLangId == logicflow"
      },
      {
        "command": "shortcircuit.openWaveform",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w",
        "when": "editorLangId == logicflow"
      },
      {
        "command": "shortcircuit.openTruthTable",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "editorLangId == logicflow"
      },
      {
        "command": "shortcircuit.formatDocument",
        "key": "shift+alt+f",
        "mac": "shift+option+f",
        "when": "editorLangId == logicflow"
      }
    ]
  },
  "scripts": {
    "build": "node build.js",
    "compile": "node build.js",
    "watch": "node build.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "node build.js && vsce package --no-git-tag-version",
    "prepublishOnly": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0",
    "vscode-languageserver": "^9.0.0",
    "vscode-languageserver-textdocument": "^1.0.16"
  }
}
