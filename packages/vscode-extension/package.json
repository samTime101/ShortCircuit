{
  "name": "shortcircuit",
  "displayName": "Short Circuit",
  "description": "LogicFlow language support for Short Circuit: syntax highlighting, diagnostics, completions, hovers, waveform/truth-table previews, and test runner.",
  "version": "0.1.0",
  "publisher": "samTime101",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Testing"
  ],
  "keywords": [
    "logicflow",
    "shortcircuit",
    "digital-logic",
    "hardware-description"
  ],
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samTime101/ShortCircuit.git"
  },
  "bugs": {
    "url": "https://github.com/samTime101/ShortCircuit/issues"
  },
  "main": "out/extension.js",
  "activationEvents": [
    "onLanguage:logicflow"
  ],
  "contributes": {
    "languages": [
      {
        "id": "logicflow",
        "aliases": [
          "LogicFlow",
          "Short Circuit"
        ],
        "extensions": [
          ".lf"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "logicflow",
        "scopeName": "source.logicflow",
        "path": "./syntaxes/logicflow.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Short Circuit",
      "properties": {
        "shortcircuit.registryUrl": {
          "type": "string",
          "default": "https://raw.githubusercontent.com/samTime101/ShortCircuit-Packages/main/registry.json",
          "description": "Registry URL for package installation"
        },
        "shortcircuit.enablePreview": {
          "type": "boolean",
          "default": true,
          "description": "Enable waveform and truth-table previews"
        },
        "shortcircuit.test.autoRun": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run tests on save"
        }
      }
    },
    "commands": [
      {
        "command": "shortcircuit.openWaveform",
        "title": "Open Waveform Preview",
        "category": "Short Circuit"
      },
      {
        "command": "shortcircuit.openTruthTable",
        "title": "Open Truth Table Preview",
        "category": "Short Circuit"
      },
      {
        "command": "shortcircuit.runTest",
        "title": "Run Test",
        "category": "Short Circuit"
      },
      {
        "command": "shortcircuit.runAllTests",
        "title": "Run All Tests in File",
        "category": "Short Circuit"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "editorLangId == logicflow",
          "command": "shortcircuit.openWaveform",
          "group": "navigation"
        },
        {
          "when": "editorLangId == logicflow",
          "command": "shortcircuit.openTruthTable",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "when": "editorLangId == logicflow",
          "command": "shortcircuit.runTest",
          "group": "shortcircuit"
        }
      ]
    },
    "keybindings": [
      {
        "command": "shortcircuit.openWaveform",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w",
        "when": "editorLangId == logicflow"
      },
      {
        "command": "shortcircuit.openTruthTable",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "editorLangId == logicflow"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "package": "vsce package",
    "prepublishOnly": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "vscode-languageclient": "^9.0.0",
    "vscode-languageserver": "^9.0.0",
    "vscode-languageserver-protocol": "^3.17.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0",
    "vscode-languageserver-textdocument": "^1.0.16"
  }
}
